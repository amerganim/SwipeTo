{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swipeto.dev/schemas/v1/handoff.schema.json",
  "title": "handoff",
  "description": "Phone hands media to the receiver at a position.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "type": {
      "const": "handoff"
    },
    "media": {
      "$ref": "common.schema.json#/$defs/media"
    },
    "positionMs": {
      "$ref": "common.schema.json#/$defs/positionMs"
    },
    "playing": {
      "type": "boolean"
    },
    "transition": {
      "enum": [
        "next",
        "previous"
      ]
    }
  },
  "required": [
    "type",
    "media",
    "positionMs",
    "playing"
  ],
  "unevaluatedProperties": false
}
