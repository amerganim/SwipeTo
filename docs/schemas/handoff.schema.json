{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swipeto.dev/schemas/v1/handoff.schema.json",
  "title": "handoff",
  "description": "Phone hands media to the receiver at a position.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "type": {
      "const": "handoff"
    },
    "media": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "video",
            "image"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$",
          "maxLength": 2048
        },
        "mime": {
          "type": "string",
          "pattern": "^(video|image)/[A-Za-z0-9.+-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "durationMs": {
          "$ref": "common.schema.json#/$defs/positionMs"
        }
      },
      "required": [
        "kind",
        "url",
        "mime",
        "title"
      ],
      "additionalProperties": false
    },
    "positionMs": {
      "$ref": "common.schema.json#/$defs/positionMs"
    },
    "playing": {
      "type": "boolean"
    }
  },
  "required": [
    "type",
    "media",
    "positionMs",
    "playing"
  ],
  "unevaluatedProperties": false
}
