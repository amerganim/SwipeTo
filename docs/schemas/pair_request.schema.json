{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swipeto.dev/schemas/v1/pair_request.schema.json",
  "title": "pair_request",
  "description": "Phone asks to pair. Receiver shows a 6-digit code.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "type": {
      "const": "pair_request"
    },
    "senderId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "senderName": {
      "$ref": "common.schema.json#/$defs/deviceName"
    }
  },
  "required": [
    "type",
    "senderId",
    "senderName"
  ],
  "unevaluatedProperties": false
}
