{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swipeto.dev/schemas/v1/error.schema.json",
  "title": "error",
  "description": "Something went wrong with a message or the session.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "type": {
      "const": "error"
    },
    "code": {
      "$ref": "common.schema.json#/$defs/errorCode"
    },
    "message": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "type",
    "code",
    "message"
  ],
  "unevaluatedProperties": false
}
