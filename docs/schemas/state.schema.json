{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swipeto.dev/schemas/v1/state.schema.json",
  "title": "state",
  "description": "Receiver playback state, every 1 s and on change.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "type": {
      "const": "state"
    },
    "positionMs": {
      "$ref": "common.schema.json#/$defs/positionMs"
    },
    "playing": {
      "type": "boolean"
    },
    "ended": {
      "type": "boolean"
    }
  },
  "required": [
    "type",
    "positionMs",
    "playing",
    "ended"
  ],
  "unevaluatedProperties": false
}
