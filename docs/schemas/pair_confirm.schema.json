{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swipeto.dev/schemas/v1/pair_confirm.schema.json",
  "title": "pair_confirm",
  "description": "Phone sends the code the user typed.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "type": {
      "const": "pair_confirm"
    },
    "code": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    }
  },
  "required": [
    "type",
    "code"
  ],
  "unevaluatedProperties": false
}
