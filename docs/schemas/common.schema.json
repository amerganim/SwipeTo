{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swipeto.dev/schemas/v1/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "positionMs": {
      "type": "integer",
      "minimum": 0
    },
    "deviceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "trustToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,128}$"
    },
    "errorCode": {
      "enum": [
        "unsupported_media",
        "not_paired",
        "bad_message",
        "busy",
        "version_mismatch",
        "service_unavailable"
      ]
    },
    "envelope": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*$"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "replyTo": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "type",
        "id",
        "ts"
      ]
    },
    "markerNonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,64}$"
    },
    "media": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "video",
            "image"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$",
          "maxLength": 2048
        },
        "mime": {
          "type": "string",
          "pattern": "^(video|image)/[A-Za-z0-9.+-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "durationMs": {
          "$ref": "common.schema.json#/$defs/positionMs"
        }
      },
      "required": [
        "kind",
        "url",
        "mime",
        "title"
      ],
      "additionalProperties": false
    },
    "appMedia": {
      "description": "Content of another app's service, opened by the receiver with that service's own player (section 5.4).",
      "type": "object",
      "properties": {
        "kind": {
          "const": "app"
        },
        "service": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "channel": {
          "type": "string",
          "maxLength": 200
        },
        "contentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "contentUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048
        },
        "durationMs": {
          "$ref": "common.schema.json#/$defs/positionMs"
        }
      },
      "required": [
        "kind",
        "service",
        "title"
      ],
      "additionalProperties": false
    },
    "anyMedia": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/media"
        },
        {
          "$ref": "common.schema.json#/$defs/appMedia"
        }
      ]
    }
  }
}
