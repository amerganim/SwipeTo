<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>End-to-end tests: launch the built Windows receiver and drive it with the mock sender. Opt in with SWIPETO_E2E=1 (they take over the screen).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\..\tools\mock-sender\SwipeTo.MockSender.csproj" />
    <!-- Plain .NET pieces of the receiver, unit-tested without launching it. -->
    <Compile Include="..\SwipeTo.Receiver.Windows\Services\YouTubeLookup.cs" Link="Linked\YouTubeLookup.cs" />
  </ItemGroup>

</Project>
